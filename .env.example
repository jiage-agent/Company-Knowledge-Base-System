# ============================================================
# 配置模板：复制成 .env 后填入自己的密钥
#   copy .env.example .env
#
# 设计原则：所有外部依赖（对话模型 / 向量模型 / 重排模型 / 向量库）
# 都通过环境变量注入，业务代码只依赖抽象接口 —— 这是"热切换"能成立的前提。
# ============================================================

# ---------- 基础 ----------
APP_NAME=Company-Knowledge-Base-System
APP_ENV=dev
DEBUG=true

# ---------- 生成模型（LLM）----------
# 任何 OpenAI 兼容协议的服务都能用：DeepSeek / 通义 / 月之暗面 / 本地 vLLM / Ollama
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your-deepseek-api-key
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=90

# ---------- 向量模型（Embedding）----------
# 热切换：EMBEDDING_PROVIDER 改成 local 就切到本地 BGE 模型，代码零改动
#   dashscope -> 阿里云百炼 text-embedding-v4（1024 维，走 OpenAI 兼容协议）
#   local     -> sentence-transformers 本地模型（BAAI/bge-small-zh-v1.5 512 维 / bge-m3 1024 维）
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=10
EMBEDDING_API_KEY=your-dashscope-api-key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_LOCAL_MODEL=BAAI/bge-small-zh-v1.5
HF_ENDPOINT=https://hf-mirror.com

# ---------- 重排模型（Reranker）----------
# api   -> 阿里云百炼 gte-rerank-v2（零下载、开箱可用，返回 0~1 相关性分数）
# local -> 本地 Cross-Encoder（离线可用，需下载模型）
# none  -> 关闭重排（消融实验对照组）
RERANK_ENABLED=true
RERANK_PROVIDER=api
RERANK_MODEL=gte-rerank-v2
RERANK_LOCAL_MODEL=BAAI/bge-reranker-base
RERANK_TOP_N=30
RERANK_DEVICE=auto

# ---------- 向量库 ----------
# chroma -> milvus 只改这一行（已做适配器抽象）
VECTOR_STORE_TYPE=chroma
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=enterprise_kb

# ---------- 关系库 ----------
# 升级 PostgreSQL 时只改这一行：postgresql+asyncpg://user:pwd@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./data/sqlite/app.db

# ---------- 切分 ----------
# recursive（按分隔符递归，快）| semantic（按相邻句相似度切，更准但要多调 embedding）
CHUNK_STRATEGY=recursive
CHUNK_SIZE=240
CHUNK_OVERLAP=50
PARENT_CHUNK_SIZE=900
SEMANTIC_THRESHOLD=0.62

# ---------- 检索 ----------
DENSE_TOP_K=20
SPARSE_TOP_K=20
FUSION_TOP_K=20
RERANK_TOP_K=5
RRF_K=60
DENSE_WEIGHT=0.7
SPARSE_WEIGHT=0.3

# 相关性阈值：必须**分阶段标定**（不同阶段分数量纲不可比）
#   稠密检索 -> 余弦相似度（无关约 0.1~0.25，相关通常 > 0.4）
#   RRF 融合 -> 1/(k+rank) 累加，天然只有 0.01~0.03（设阈值会误杀，默认关闭）
#   重排      -> 归一化相关性（无关 < 0.02）
MIN_RELEVANCE_SCORE_DENSE=0.30
MIN_RELEVANCE_SCORE_RRF=0.0
MIN_RELEVANCE_SCORE_RERANK=0.02
MIN_RELEVANCE_SCORE=0.0

# ---------- Agent 编排 ----------
MAX_RETRY=2
GRAPH_RECURSION_LIMIT=25
AGENT_TIMEOUT_SECONDS=90

# ---------- 可观测（LangSmith 全链路追踪，可不填）----------
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=company-kb-agentic-rag

# ---------- 安全 ----------
# 生产环境务必换成随机长字符串：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
